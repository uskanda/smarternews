{
  "name": "smarternews",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted AI news crawler that serves one article per story over an API and RSS.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/mobile/tsconfig.json",
    "test": "vitest run --passWithNoTests && pnpm --filter @smarternews/mobile run test",
    "check:private": "node scripts/check-private.ts",
    "start": "node apps/server/src/main.ts serve",
    "build": "pnpm --filter @smarternews/web run build",
    "tokens": "node scripts/design-tokens.ts",
    "check:tokens": "node scripts/design-tokens.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.4.1"
}
