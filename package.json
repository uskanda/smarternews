{
  "name": "smarternews",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted AI news crawler that serves one article per story over an API and RSS.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "check:private": "node scripts/check-private.ts",
    "start": "node apps/server/src/main.ts serve"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.4.1"
}
