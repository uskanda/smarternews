# systemd user unit. Install with:
#   mkdir -p ~/.config/systemd/user
#   cp examples/smarternews.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now smarternews
#   loginctl enable-linger "$USER"     # keep it running after you log out
# Adjust WorkingDirectory to where you cloned the repository.

[Unit]
Description=smarternews: AI news crawler, API and feeds
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/smarternews
# The two flags cap the JavaScript heap. Without them, Node sizes the heap from the machine's memory and, on a
# host with plenty of it, keeps several hundred MB it no longer uses. 256 MB leaves room for the largest page the
# server accepts (2 MB); below about 160 MB such a page can end the process for want of memory.
ExecStart=/usr/bin/env node --max-old-space-size=256 --max-semi-space-size=4 apps/server/src/main.ts serve
# Come back after any exit, a clean one included: a signal from another program ends the server with
# status 0, which "on-failure" would not restart. `systemctl --user stop` still stops it for good.
Restart=always
RestartSec=30
# The default provider runs the `claude` command, so it must be on this PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Optional: API keys the providers and the translation API read, such as ANTHROPIC_API_KEY for a provider
# with `adapter: anthropic` and GOOGLE_TRANSLATE_API_KEY when config.yaml names it under
# translation.google.apiKeyEnv. Keep the keys out of this unit: put lines such as ANTHROPIC_API_KEY=<key>
# into a file only you can read (chmod 600). The "-" lets the service start without the file.
EnvironmentFile=-%h/.config/smarternews/env

[Install]
WantedBy=default.target
