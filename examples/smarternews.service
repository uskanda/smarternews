# systemd user unit. Install with:
#   mkdir -p ~/.config/systemd/user
#   cp examples/smarternews.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now smarternews
#   loginctl enable-linger "$USER"     # keep it running after you log out
# Adjust WorkingDirectory to where you cloned the repository.

[Unit]
Description=smarternews: AI news crawler, API and feeds
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/smarternews
ExecStart=/usr/bin/env node apps/server/src/main.ts serve
# Come back after any exit, a clean one included: a signal from another program ends the server with
# status 0, which "on-failure" would not restart. `systemctl --user stop` still stops it for good.
Restart=always
RestartSec=30
# The default provider runs the `claude` command, so it must be on this PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Optional: the key of the translation API, when config.yaml names GOOGLE_TRANSLATE_API_KEY under
# translation.google.apiKeyEnv. Keep the key out of this unit: put the line GOOGLE_TRANSLATE_API_KEY=<key>
# into a file only you can read (chmod 600). The "-" lets the service start without the file.
EnvironmentFile=-%h/.config/smarternews/env

[Install]
WantedBy=default.target
